# ==============================================================================
# KUETcord Environment Configuration Template (.env.example)
# Copy this file to .env and configure values before starting Docker or local app
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_DB=kuetcord_db
POSTGRES_USER=kuetcord_admin
POSTGRES_PASSWORD=kuetcord_secure_pass
POSTGRES_PORT=5432

# Spring Boot Backend Configuration
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/kuetcord_db
SPRING_DATASOURCE_USERNAME=kuetcord_admin
SPRING_DATASOURCE_PASSWORD=kuetcord_secure_pass

# Security & Authentication (Base64-encoded 256-bit secret)
JWT_SECRET=c2VjdXJlX2p3dF90ZXN0X3NlY3JldF9mb3JfZ2l0aHViX2FjdGlvbnNfMTIzNDU2Nzg5MA==
JWT_EXPIRATION_MS=86400000

# Google OAuth2 / OIDC Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Mail Configuration (Mailpit for local dev, SMTP for prod)
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Allowed Frontend Origins (CORS & WebSocket Handshake)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://kuetcord.onrender.com,https://kuetcord.vercel.app

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_BASE_URL=ws://localhost:8080/ws

